# Auth.js / NextAuth
AUTH_SECRET=generate-with-openssl-rand-base64-32
# Must be the public URL of this deployment (localhost locally, staging/prod URL on server)
AUTH_URL=http://localhost:3000
# Optional on Vercel — trustHost is enabled in auth.ts; set if needed:
# AUTH_TRUST_HOST=true

# Google OAuth2 (used for dashboard sign-in AND exchanged for backend admin JWT)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Backend API (server-side calls + Next.js rewrite proxy target)
# Admin endpoints require Bearer token from POST /api/v1/admin/auth/google
API_BASE_URL=http://localhost:8001
# Optional: only needed if API_BASE_URL is not set
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
